FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd -r hunter && useradd -r -g hunter -m -d /home/hunter hunter

WORKDIR /app
COPY pyproject.toml /app/
COPY src /app/src

RUN pip install --no-cache-dir . && \
    mkdir -p /quarantine /out && \
    chown -R hunter:hunter /app /out

USER hunter
ENTRYPOINT ["artex-hunt"]
