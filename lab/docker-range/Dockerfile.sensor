FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    suricata \
    yara \
    tcpdump \
    iproute2 \
    procps \
    nginx \
    openssl \
    curl \
    python3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/log/suricata /etc/suricata/rules /out

WORKDIR /work
