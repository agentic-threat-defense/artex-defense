# ============================================================================
# ARTEX / ScopeWeaver / Norma Agent Harness — Starter Suricata 6/7 Rules
# Note: Uses Suricata sticky buffers (http.uri, http.user_agent, http.header,
#       http.request_body, http.response_body, tls.sni, tls.cert_issuer). For Snort 2/3 IPS,
#       cross-reference Cisco Talos official Snort 2 (1:67494-67496) & Snort 3 (7:76-78).
# ============================================================================

# 1. Explicit ARTEX / Norma Harness User-Agents (prefiltered via content fast-patterns)
alert http any any -> $HOME_NET any (msg:"ARTEX-DEFENSE Norma SDK or ARTEX Worker User-Agent"; flow:to_server,established; http.user_agent; content:"norma/"; nocase; pcre:"/norma\/[0-9]/i"; threshold:type limit, track by_src, count 1, seconds 60; classtype:attempted-recon; sid:9100001; rev:9;)

alert http any any -> $HOME_NET any (msg:"ARTEX-DEFENSE ARTEX Framework or Self-Proclaimed Authorized Scanner User-Agent"; flow:to_server,established; http.user_agent; pcre:"/(artex-enrich\/|rex_enrich|artex-readonly\/|ARTEX-worker\/|(?:^|[^a-z0-9_])artex-(?:agent(?=$|[^a-z0-9_])|judge-[a-z0-9_-]+)|artex-selfupdate|ArtExVerify\/|ArtEx\/1\.0|Mozilla\/5\.0 \(ARTEX\)|security-testing\x3b authorized|LLMLeak-RedTeam\/|authorized-security-research\/|authorized-exposure-audit\/|authori[sz]ed[-_ \x3b\/]+(?:scan|audit|pentest|exposure|security|recon|research)|vulnerability-disclosure-policy-review|recon-audit|Fuzz Faster U Fool|ArtexProbe|artex-probe|ScopeWeaver|hermes-agent\/|strix\/|RedAmon-AISurfaceRecon\/)/i"; threshold:type limit, track by_src, count 1, seconds 60; classtype:attempted-recon; sid:9100014; rev:6;)

# 2. Unit 42 / GreyNoise / ThreatDefence / Bitrise Canary & Task-Iteration Probes (properly buffered on http.uri & http.request_body)
alert http any any -> $HOME_NET any (msg:"ARTEX-DEFENSE Agentic Control-404 Canary or Write/Persist Probe in URI"; flow:to_server,established; http.uri; pcre:"/(zz_no_such_user|zzq\.nonexistent|precheck\.not-a-user|zzzrandom\d+|zz-no-such-key|zz-notexist-|ARTEX_WRITE_PROBE|ARTEX_PERSIST_OK|rEdAm0n1337XsS|redamon-poc\.invalid|xalgorix-(?:nonexistent|missing|xxe)-|evil\.pentestswarm\.invalid|_i\d{2,6}_probe(?:_[a-z0-9_-]+)?|(?:^|[\/_-])i\d{2,6}-probe(?=$|[\/?&#])|[?&]artex=)/i"; classtype:attempted-recon; sid:9100009; rev:6;)

alert http any any -> $HOME_NET any (msg:"ARTEX-DEFENSE Agentic Write/Persist Canary Probe in HTTP Request Body"; flow:to_server,established; http.request_body; content:"artex_"; nocase; pcre:"/(?:ARTEX_WRITE_PROBE|ARTEX_PERSIST_OK|artex_control_marker)/i"; classtype:attempted-recon; sid:9100016; rev:1;)

# 3. X-ARTX-KEY Header or Case-Sensitive JWT alg:none Probe (properly buffered on http.header)
alert http any any -> $HOME_NET any (msg:"ARTEX-DEFENSE X-ARTX-KEY Custom Probe Header"; flow:to_server,established; http.header; content:"X-ARTX-KEY"; nocase; classtype:attempted-recon; sid:9100012; rev:1;)

alert http any any -> $HOME_NET any (msg:"ARTEX-DEFENSE JWT alg:none Unsigned Token Probe in HTTP Header"; flow:to_server,established; http.header; content:"eyJ"; pcre:"/ey(?=J)[A-Za-z0-9_-]{0,64}(?:JhbGciOi(?:Jub25lI|JOb25lI|JOT05FI|Aibm9uZS[JI]|AiTm9uZS[JI]|AiTk9ORS[JI])|ImFsZyI6(?:Im5vbmUi|Ik5vbmUi|Ik5PTkUi|ICJub25lI|ICJOb25lI|ICJOT05FI)|iYWxnIjo(?:ibm9uZS[JI]|iTm9uZS[JI]|iTk9ORS[JI]|gIm5vbmUi|gIk5vbmUi|gIk5PTkUi))[A-Za-z0-9_-]*\./"; classtype:attempted-recon; sid:9100015; rev:2;)

# 4. Exposed ARTEX Infrastructure WWW-Authenticate Basic Realm (flexible whitespace/charset)
alert http any any -> any any (msg:"ARTEX-DEFENSE Exposed ARTEX Infrastructure WWW-Authenticate Basic Realm"; flow:from_server,established; http.header; content:"WWW-Authenticate"; nocase; content:"realm=|22|ARTEX|22|"; nocase; distance:0; classtype:policy-violation; sid:9100010; rev:2;)

# 5. VAPOR PANDA BLOODALCHEMY C2 URI (/Inform/logger/)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ARTEX-DEFENSE VAPOR PANDA BLOODALCHEMY C2 URI (/Inform/logger/)"; flow:to_server,established; http.uri; content:"/Inform/logger/"; classtype:trojan-activity; sid:9100006; rev:1;)

# 6. Outbound TLS to Confirmed ARTEX / BLOODALCHEMY LLM Relay & C2 Domains (port-agnostic)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ARTEX-DEFENSE Outbound TLS to ARTEX/BLOODALCHEMY Relay or C2 Domain"; flow:to_server,established; tls.sni; dotprefix; pcre:"/\.(?:xcai\.(?:com|pro)|artex\.lol|lanmao666\.(?:com|xyz)|nginxmysql\.com|vietnam852\.com|zhzy999\.net|sqlserver-sqlite\.com|artex\.noog2infra\.site|artex\.ok7777\.eu\.cc|artex\.tokena2b\.top)$/i"; classtype:trojan-activity; sid:9100007; rev:5;)

# 7. Self-Signed ARTEX X.509 Certificate Issuer (exact RDN O=ARTEX; avoids O=ARTEX Logistics / O=SMARTEX FPs)
alert tls any any -> any any (msg:"ARTEX-DEFENSE Self-Signed ARTEX X.509 Certificate Issuer"; flow:from_server,established; tls.cert_issuer; content:"O=ARTEX"; pcre:"/(?:^|,\s*)O=ARTEX(?:,|$)/"; classtype:policy-violation; sid:9100013; rev:2;)

# 8. Outbound External HTTP Traffic to Default ARTEX/ScopeWeaver/MCP Console Ports (excludes Zscaler header & internal dev ports)
# Note: CyberStrikeAI ports [5001,5002,5003,8082] are omitted from this default port rule to avoid enterprise Flask/gRPC/Traefik/Tomcat FPs.
alert http $HOME_NET any -> $EXTERNAL_NET [8787,8788,8790,8890,18899] (msg:"ARTEX-DEFENSE Outbound External HTTP to Default ARTEX/ScopeWeaver/MCP Console Port (8787/8788/8790/8890/18899)"; flow:to_server,established; http.header; content:!"X-Zscaler"; nocase; threshold:type limit, track by_src, count 1, seconds 300; classtype:policy-violation; sid:9100002; rev:4;)

# 9. Exposed ARTEX Autonomous Pentest Console HTML Title (both inbound & outbound browsing)
alert http any any -> any any (msg:"ARTEX-DEFENSE Exposed ARTEX Autonomous Pentest Console HTML Title"; flow:from_server,established; http.response_body; content:"|E8 87 AA E4 B8 BB E6 B8 97 E9 80 8F E6 B5 8B E8 AF 95 E6 8E A7 E5 88 B6 E5 8F B0|"; classtype:policy-violation; sid:9100003; rev:2;)

# 10. Rebranded ARTEX Fork Console <title> (EN/KR/rebrands; prefiltered on <title> to avoid body-scan FPs; KR/EN suffixes cross-referenced with Athar-HQ/Athar DRL 1.1)
alert http any any -> any any (msg:"ARTEX-DEFENSE Rebranded ARTEX Fork Console HTML Title (ARTEX MX / AntiFox / ScopeWeaver / EN-KR Console)"; flow:from_server,established; http.response_body; content:"<title"; nocase; pcre:"/<title[^>]*>[^<]{0,120}(?:Agent Security Workbench|ARTEX MX|AntiFox|ScopeWeaver|Autonomous Penetration Testing Console|\xec\x9e\x90\xec\x9c\xa8\x20\xec\xb9\xa8\xed\x88\xac\x20\xed\x85\x8c\xec\x8a\xa4\xed\x8a\xb8\x20\xec\xbd\x98\xec\x86\x94)[^<]{0,120}<\/title>/i"; classtype:policy-violation; sid:9100008; rev:3;)

# 11. Outbound TLS to Webhook / OAST Exfiltration & IMDS Wildcard-IP DNS SSRF Bypass Domains (port-agnostic)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ARTEX-DEFENSE Outbound TLS to webhook.site Exfiltration Domain"; flow:to_server,established; tls.sni; dotprefix; content:".webhook.site"; endswith; nocase; classtype:policy-violation; sid:9100004; rev:2;)

alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ARTEX-DEFENSE Outbound TLS to OAST/Interactsh/DNSLog Exfiltration Domain"; flow:to_server,established; tls.sni; dotprefix; pcre:"/\.(?:oast\.(?:live|fun|me|pro|site|online)|interact\.sh|dnslog\.cn)$/i"; classtype:policy-violation; sid:9100011; rev:2;)

alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ARTEX-DEFENSE Outbound TLS to IMDS Wildcard-IP DNS SSRF Bypass Domain"; flow:to_server,established; tls.sni; dotprefix; pcre:"/[.\-](?:169[.\-]254[.\-](?:169[.\-]254|170[.\-]2)|a9fea9fe)\.(?:sslip\.io|nip\.io|xip\.io|traefik\.me)$/i"; classtype:attempted-recon; sid:9100017; rev:1;)

# 12. Rapid Automated Nuclei / HeadlessChrome / Norma Probing Against Edge VPN/Gateway URIs
alert http any any -> $HOME_NET any (msg:"ARTEX-DEFENSE Rapid Automated Nuclei/HeadlessChrome/Norma Probing Against Edge VPN/Gateway URI"; flow:to_server,established; http.uri; content:"/"; pcre:"/^\/(?:\+CSCOE\+\/|\+webvpn\+\/|vpn\/|nf\/auth\/|logon\/LogonPoint\/|p\/u\/|nitro\/v1|global-protect\/|ssl-vpn\/|my\.policy|tmui\/|mgmt\/tm\/)/i"; http.user_agent; pcre:"/(?:Nuclei|HeadlessChrome|norma\/[0-9]|norma-agent)/i"; detection_filter:track by_src, count 5, seconds 30; classtype:web-application-attack; sid:9100005; rev:2;)

# 13. SOAP OSExecute & SAPControl Sensitive Read Envelopes + Apache .htaccess PHP Re-Activation Upload
alert http any any -> $HOME_NET any (msg:"ARTEX-DEFENSE SOAP OSExecute Remote Command Execution Request"; flow:to_server,established; http.request_body; content:"OSExecute"; nocase; pcre:"/<(?:[a-z0-9_-]+\x3a)?OSExecute(?:\s|>|\/)/i"; classtype:web-application-attack; sid:9100018; rev:1;)

alert http any any -> $HOME_NET any (msg:"ARTEX-DEFENSE SAPControl SOAP Credential/Config Read Probe (GetEnvironment/ReadConfigFile/ReadLogFile)"; flow:to_server,established; http.request_body; content:"Envelope"; nocase; pcre:"/<(?:[a-z0-9_-]+\x3a)?(?:GetEnvironment|ReadConfigFile|ReadLogFile)(?:\s|>|\/)/i"; classtype:attempted-recon; sid:9100019; rev:1;)

alert http any any -> $HOME_NET any (msg:"ARTEX-DEFENSE Apache .htaccess PHP Execution Re-Activation Upload"; flow:to_server,established; http.request_body; content:"x-httpd-php"; nocase; pcre:"/(?:SetHandler|AddType)\s+application\/x-httpd-php/i"; classtype:web-application-attack; sid:9100020; rev:1;)

# 14. Ruby2Shell (CVE-2026-132825) Legacy Single-Byte Charset + Dense 0xDF ('ß') Expansion Heap-Overflow Probe
# Requires BOTH ISO-8859-1/Windows-1252 charset AND >=4 consecutive 0xDF / %DF bytes so normal European text (e.g. "Straße") produces 0 FP.
alert http any any -> $HOME_NET any (msg:"ARTEX-DEFENSE Ruby2Shell (CVE-2026-132825) ISO-8859-1/Windows-1252 Dense 0xDF Heap-Overflow Probe"; flow:to_server,established; http.header; content:"charset="; nocase; pcre:"/charset=\s*\"?(?:iso[-_]?8859[-_]?1|windows[-_]?1252|latin[-_]?1)\b/i"; http.request_body; pcre:"/(?:\xdf{4,}|(?:%df){4,})/i"; classtype:web-application-attack; sid:9100021; rev:1;)

# 15. ARTEX Landing-Page Redirect Stub (`<title>artex</title>` + `url=/function/tasks/` — Athar v0.5.0 / Florian Roth, DRL 1.1)
alert http any any -> any any (msg:"ARTEX-DEFENSE ARTEX Landing-Page Redirect Stub to /function/tasks/"; flow:from_server,established; http.response_body; content:"url=/function/tasks/"; nocase; content:"<title>artex</title>"; nocase; classtype:policy-violation; sid:9100022; rev:1;)
