//     factor_changes = COUNT(*) WHERE event.action IN ("user.mfa.factor.activate", "user.mfa.factor.deactivate", "user.mfa.factor.reset_all"),
//     probe_signups = COUNT(*) WHERE event.action == "user.lifecycle.create",
//     risk_hits = COUNT(*) WHERE event.action == "user.risk.detect",
//     suspicious_workflow_invokes = COUNT(*) WHERE event.action == "workflows.user.invoke" AND (okta.debug_context.debug_data.request_uri LIKE "*/api/flo/*" OR okta.debug_context.debug_data.request_uri LIKE "*clientToken=*"),
//     successes = COUNT(*) WHERE event.outcome == "success"
//   BY source.ip, bucket = DATE_TRUNC(15 minutes, @timestamp)
// | WHERE (failed_users >= 5 AND successes >= 1) OR mfa_fails >= 4 OR probe_signups >= 5 OR risk_hits >= 3 OR suspicious_workflow_invokes >= 1 OR (factor_changes >= 1 AND (failed_users >= 1 OR mfa_fails >= 1))
// | SORT mfa_fails DESC, probe_signups DESC, failed_users DESC
//
// 9. [ES|QL — TIER 2] CyberStrikeAI CloudTrail: EC2 userData / SSM Decryption Burst & Multi-Identity External IP Pivot
// FROM logs-aws.cloudtrail-*
// | WHERE source.ip IS NOT NULL
//   AND event.action IN ("DescribeInstanceAttribute", "GetParameter", "GetParametersByPath", "SendCommand", "GetSecretValue")
// | STATS
//     calls = COUNT(*),
//     distinct_identities = COUNT_DISTINCT(aws.cloudtrail.user_identity.arn),
//     ec2_role_userdata = COUNT(*) WHERE aws.cloudtrail.user_identity.arn RLIKE ".*/i-[0-9a-f]{8,17}$" AND event.action == "DescribeInstanceAttribute",
//     shell_send_cmds = COUNT(*) WHERE event.action == "SendCommand" AND TO_STRING(aws.cloudtrail.request_parameters) LIKE "*AWS-Run*Script*",
//     userdata_calls = COUNT(*) WHERE event.action == "DescribeInstanceAttribute" AND TO_STRING(aws.cloudtrail.request_parameters) LIKE "*userData*",
//     ssm_decrypts = COUNT(*) WHERE event.action IN ("GetParameter", "GetParametersByPath") AND TO_STRING(aws.cloudtrail.request_parameters) LIKE "*withDecryption*true*"
//   BY source.ip, bucket = DATE_TRUNC(15 minutes, @timestamp)
// | WHERE distinct_identities >= 3 OR userdata_calls >= 4 OR (ec2_role_userdata >= 2 AND ssm_decrypts >= 1) OR (shell_send_cmds >= 1 AND (userdata_calls >= 1 OR ssm_decrypts >= 1))
// | SORT distinct_identities DESC, calls DESC
