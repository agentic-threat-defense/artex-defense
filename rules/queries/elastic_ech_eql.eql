//     failed_users = COUNT_DISTINCT(user.name) WHERE event.outcome == "failure",
//     mfa_fails = COUNT(*) WHERE event.action IN ("user.mfa.okta_verify.deny_push", "user.authentication.auth_via_mfa") AND event.outcome == "failure",
//     factor_changes = COUNT(*) WHERE event.action IN ("user.mfa.factor.activate", "user.mfa.factor.deactivate"),
//     probe_signups = COUNT(*) WHERE event.action == "user.lifecycle.create",
//     risk_hits = COUNT(*) WHERE event.action == "user.risk.detect",
//     workflow_invokes = COUNT(*) WHERE event.action == "workflows.user.invoke",
//     successes = COUNT(*) WHERE event.outcome == "success"
//   BY source.ip, bucket = DATE_TRUNC(15 minutes, @timestamp)
// | WHERE (failed_users >= 5 AND successes >= 1) OR mfa_fails >= 4 OR probe_signups >= 5 OR risk_hits >= 3 OR workflow_invokes >= 1 OR (factor_changes >= 1 AND (failed_users >= 1 OR mfa_fails >= 1))
// | SORT mfa_fails DESC, probe_signups DESC, failed_users DESC
