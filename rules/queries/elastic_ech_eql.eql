//     mfa_fails = COUNT(*) WHERE event.action IN ("user.mfa.okta_verify.deny_push", "user.authentication.auth_via_mfa") AND event.outcome == "failure",
//     factor_changes = COUNT(*) WHERE event.action IN ("user.mfa.factor.activate", "user.mfa.factor.deactivate", "user.mfa.factor.reset_all"),
