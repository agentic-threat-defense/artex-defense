// 9. Elastic ES|QL — CyberStrikeAI CloudTrail: Sub-Second EC2 userData / SSM Burst & Multi-Identity External IP Pivot
// FROM logs-aws.cloudtrail-*
// | WHERE event.action IN ("DescribeInstanceAttribute", "GetParameter", "GetParametersByPath", "SendCommand", "GetSecretValue")
// | STATS
//     calls = COUNT(*),
//     distinct_identities = COUNT_DISTINCT(aws.cloudtrail.user_identity.arn),
//     ec2_roles = COUNT_DISTINCT(aws.cloudtrail.user_identity.arn) WHERE aws.cloudtrail.user_identity.arn RLIKE ".*/i-[0-9a-f]{8,17}$",
//     send_cmds = COUNT(*) WHERE event.action == "SendCommand",
//     userdata_calls = COUNT(*) WHERE event.action == "DescribeInstanceAttribute" AND aws.cloudtrail.request_parameters LIKE "*userData*"
//   BY source.ip, bucket = DATE_TRUNC(15 minutes, @timestamp)
// | WHERE distinct_identities >= 3 OR ec2_roles >= 1 OR send_cmds >= 1 OR userdata_calls >= 5
// | SORT distinct_identities DESC, calls DESC
