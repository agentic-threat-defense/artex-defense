EventType = "Process Creation" AND (EndpointOS = "windows" AND (((SrcProcImagePath containsCIS "w3wp.exe" OR SrcProcImagePath containsCIS "nginx" OR SrcProcImagePath containsCIS "httpd" OR SrcProcImagePath containsCIS "php-fpm" OR SrcProcImagePath containsCIS "restjavad") AND (TgtProcImagePath containsCIS "cmd.exe" OR TgtProcImagePath containsCIS "powershell.exe" OR TgtProcImagePath containsCIS "pwsh" OR TgtProcImagePath containsCIS "/bin/sh" OR TgtProcImagePath containsCIS "/bin/bash")) OR (TgtProcCmdLine containsCIS "nltest /domain_trusts" OR TgtProcCmdLine containsCIS "aws sts get-caller-identity" OR TgtProcCmdLine containsCIS "az account show")))

