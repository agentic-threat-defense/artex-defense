// === Autonomous Agentic AD Pivot & Tunneling Toolkit (Windows) (artex_ad_ntlm_relay_chisel_sideload_pivots.yml | id=3f7a9d12-8b54-4e61-a29f-6c4d81e5b204 | level=high) ===
imProcessCreate
| where (TargetProcessCommandLine contains "chisel" and TargetProcessCommandLine contains "client") or (TargetProcessCommandLine contains "R:socks" or TargetProcessCommandLine contains "ligolo-agent" or TargetProcessCommandLine contains "vpncmd") or (TargetProcessCommandLine contains "ntlmrelayx" or TargetProcessCommandLine contains "smbserver.py" or TargetProcessCommandLine contains "secretsdump" or TargetProcessCommandLine contains "petitpotam" or TargetProcessCommandLine contains "coercer" or TargetProcessCommandLine contains "certipy" or TargetProcessCommandLine contains "ldapdomaindump" or TargetProcessCommandLine contains "evil-winrm" or TargetProcessCommandLine contains "netexec" or TargetProcessCommandLine contains "\\Responder\\Responder.py" or TargetProcessCommandLine contains "/Responder/Responder.py") or (TargetProcessName endswith "\\cookie_exporter.exe" or TargetProcessCommandLine contains "cookie_exporter.exe") or ((((TargetProcessName endswith "\\edge.exe" or TargetProcessName endswith "\\msedge.exe") and TargetProcessCommandLine contains "config.bin") or TargetProcessName endswith "\\svchost.exe") and (not((TargetProcessName contains "\\Program Files\\" or TargetProcessName contains "\\Program Files (x86)\\" or TargetProcessName contains "\\Windows\\System32\\" or TargetProcessName contains "\\Windows\\SysWOW64\\" or TargetProcessName contains "\\Windows\\WinSxS\\" or TargetProcessName contains "\\AppData\\Local\\Microsoft\\Edge\\Application\\" or TargetProcessName contains "\\AppData\\Local\\Microsoft\\EdgeUpdate\\"))))

// === VAPOR PANDA BLOODALCHEMY Sideloading, C2 URI, or ARTEX Config/Proxy Artifacts (artex_bloodalchemy_sideload_and_c2.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a016 | level=critical) ===
imProcessCreate
| where (TargetProcessCommandLine contains "graphics-hook-filter64.dll" or TargetProcessCommandLine contains "graphics-hook_config.bin" or TargetProcessCommandLine contains "artex_config.json" or TargetProcessCommandLine contains "artex.yaml" or TargetProcessCommandLine contains "\\ProgramData\\artx5v\\" or TargetProcessCommandLine contains "/Inform/logger/" or TargetProcessCommandLine contains "xcai.com" or TargetProcessCommandLine contains "xcai.pro") or TargetProcessName contains "\\ProgramData\\artx5v\\" or (TargetProcessCommandLine contains "tomicdd/artex" or TargetProcessCommandLine contains "congdonglinux/artex")

// === Rapid Automated EDR Sensor Discovery Commands (artex_edr_evasion_probe.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a003 | level=medium) ===
imProcessCreate
| where (TargetProcessCommandLine contains "sc query" or TargetProcessCommandLine contains "Get-Service" or TargetProcessCommandLine contains "tasklist" or TargetProcessCommandLine contains "wmic process") and (TargetProcessCommandLine contains "CSFalcon" or TargetProcessCommandLine contains "CrowdStrike" or TargetProcessCommandLine contains "SentinelAgent" or TargetProcessCommandLine contains "CbDefense" or TargetProcessCommandLine contains "WinDefend" or TargetProcessCommandLine contains "Sysmon")

// === Windows Web/Service Parent Spawning Shell or Cloud/AD Recon Commands (artex_endpoint_compressed_recon_burst.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a014 | level=medium) ===
imProcessCreate
| where (((ParentProcessName endswith "\\w3wp.exe" or ParentProcessName endswith "\\nginx.exe" or ParentProcessName endswith "\\httpd.exe" or ParentProcessName endswith "\\tomcat.exe" or ParentProcessName endswith "\\sqlservr.exe") or (ActingProcessName endswith "\\w3wp.exe" or ActingProcessName endswith "\\nginx.exe" or ActingProcessName endswith "\\httpd.exe" or ActingProcessName endswith "\\tomcat.exe" or ActingProcessName endswith "\\sqlservr.exe")) and (TargetProcessName endswith "\\cmd.exe" or TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe")) or (TargetProcessCommandLine contains "nltest" and TargetProcessCommandLine contains "/domain_trusts") or (TargetProcessCommandLine contains "aws" and TargetProcessCommandLine contains "sts" and TargetProcessCommandLine contains "get-caller-identity") or (TargetProcessCommandLine contains "az" and TargetProcessCommandLine contains "account" and TargetProcessCommandLine contains "show") or (TargetProcessCommandLine contains "gcloud" and TargetProcessCommandLine contains "auth" and TargetProcessCommandLine contains "list")

// === Autonomous Agentic Linux Staging C Compilation, Proxychains/AD Pivot, or ARTEX Host Artifacts (artex_linux_staging_compiler_and_proxychains_pivot.yml | id=9f4e2a17-6b3c-4d8e-9a51-2c7b80e4d312 | level=high) ===
imProcessCreate
| where ((TargetProcessName endswith "gcc" or TargetProcessName endswith "g++" or TargetProcessName endswith "clang" or TargetProcessName endswith "clang++" or TargetProcessName endswith "/cc") and (TargetProcessCommandLine contains "/tmp/" or TargetProcessCommandLine contains "/dev/shm/" or TargetProcessCommandLine contains "/var/tmp/") and (not(((ParentProcessName endswith "/dpkg" or ParentProcessName endswith "/apt" or ParentProcessName endswith "/yum" or ParentProcessName endswith "/dnf" or ParentProcessName endswith "/rpm" or ParentProcessName endswith "/pip" or ParentProcessName endswith "/pip3" or ParentProcessName endswith "/cargo" or ParentProcessName endswith "/go" or ParentProcessName endswith "/dkms" or ParentProcessName endswith "/cmake") or (ActingProcessName endswith "/dpkg" or ActingProcessName endswith "/apt" or ActingProcessName endswith "/yum" or ActingProcessName endswith "/dnf" or ActingProcessName endswith "/rpm" or ActingProcessName endswith "/pip" or ActingProcessName endswith "/pip3" or ActingProcessName endswith "/cargo" or ActingProcessName endswith "/go" or ActingProcessName endswith "/dkms" or ActingProcessName endswith "/cmake"))))) or (TargetProcessCommandLine contains "proxychains" or TargetProcessCommandLine contains "proxychains4") or (TargetProcessCommandLine contains "chisel" and TargetProcessCommandLine contains "client") or (TargetProcessCommandLine contains "ligolo-agent" or TargetProcessCommandLine contains "ntlmrelayx" or TargetProcessCommandLine contains "smbserver.py" or TargetProcessCommandLine contains "secretsdump" or TargetProcessCommandLine contains "petitpotam" or TargetProcessCommandLine contains "coercer" or TargetProcessCommandLine contains "certipy" or TargetProcessCommandLine contains "ldapdomaindump" or TargetProcessCommandLine contains "evil-winrm" or TargetProcessCommandLine contains "netexec" or TargetProcessCommandLine contains "/Responder/Responder.py") or (((ParentProcessName endswith "/puma" or ParentProcessName endswith "/unicorn" or ParentProcessName endswith "/unicorn_rails" or ParentProcessName endswith "/passenger") or (ActingProcessName endswith "/puma" or ActingProcessName endswith "/unicorn" or ActingProcessName endswith "/unicorn_rails" or ActingProcessName endswith "/passenger")) and (TargetProcessName endswith "/sh" or TargetProcessName endswith "/bash" or TargetProcessName endswith "/dash" or TargetProcessName endswith "/zsh")) or ((TargetProcessName contains "/tmp/" or TargetProcessName contains "/dev/shm/" or TargetProcessName contains "/var/tmp/") and TargetProcessName endswith "cloudflared" and TargetProcessCommandLine contains "tunnel") or (TargetProcessCommandLine contains "mitmproxy-ca-cert.pem" or TargetProcessCommandLine contains "traffic/_index/index.sqlite" or TargetProcessCommandLine contains "/cmd-output/" or TargetProcessCommandLine contains "tomicdd/artex" or TargetProcessCommandLine contains "congdonglinux/artex") or (TargetProcessName endswith "/ssh" and (TargetProcessCommandLine contains " -R " or TargetProcessCommandLine contains " -NR " or TargetProcessCommandLine contains " -fNR " or TargetProcessCommandLine contains " -NTR " or TargetProcessCommandLine contains "RemoteForward") and TargetProcessCommandLine contains ":")

// === Potential ARTEX or ScopeWeaver Framework Artifact or Default Listener (artex_network_listener.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a001 | level=high) ===
imNetworkSession
| where ((DstPortNumber in (8787, 8788, 8790, 8890)) and (not((DstPortNumber == 8890 and ((SrcProcessName endswith "\\ZSATunnel.exe" or SrcProcessName endswith "\\ZSAService.exe" or SrcProcessName endswith "\\ZSAUpm.exe" or SrcProcessName endswith "\\ZSATray.exe") or (DstProcessName endswith "\\ZSATunnel.exe" or DstProcessName endswith "\\ZSAService.exe" or DstProcessName endswith "\\ZSAUpm.exe" or DstProcessName endswith "\\ZSATray.exe")))))) or ((SrcProcessName contains "ScopeWeaver" or SrcProcessName contains "AntiFox" or SrcProcessName contains "Pojun" or SrcProcessName contains "FORANG" or SrcProcessName contains "sco-fix2" or SrcProcessName contains "artx5v" or SrcProcessName contains "artex-server" or SrcProcessName contains "artex-worker" or SrcProcessName contains "norma-agent") or (DstProcessName contains "ScopeWeaver" or DstProcessName contains "AntiFox" or DstProcessName contains "Pojun" or DstProcessName contains "FORANG" or DstProcessName contains "sco-fix2" or DstProcessName contains "artx5v" or DstProcessName contains "artex-server" or DstProcessName contains "artex-worker" or DstProcessName contains "norma-agent"))

// === ARTEX Post-Exploitation AD Credential Dumping (Kerberoast/DCSync) or Follow-On C2 (vshell/AdaptixC2/WISP) (artex_post_exploit_ad_and_followon_c2.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a020 | level=critical) ===
imProcessCreate
| where (TargetProcessCommandLine contains "lsadump::" or TargetProcessCommandLine contains "sekurlsa::" or TargetProcessCommandLine contains "kerberoast" or TargetProcessCommandLine contains "GetUserSPNs" or TargetProcessCommandLine contains "DS-Replication-Get-Changes") or (((TargetProcessCommandLine contains "vshell.exe" or TargetProcessCommandLine contains "vshell " or TargetProcessCommandLine contains "AdaptixC2" or TargetProcessCommandLine contains "wisp-c2" or TargetProcessCommandLine contains "wisp_c2" or TargetProcessCommandLine contains "sqlserver-sqlite.com") or (TargetProcessName endswith "\\vshell.exe" or TargetProcessName endswith "\\wisp.exe")) and (not((TargetProcessCommandLine contains "VsDevShell" or TargetProcessCommandLine contains "VisualStudio.DevShell"))))
