// === Autonomous Agentic AD Pivot Toolkit (Chisel/Proxychains, NTLM Relay, Relocated DLL Sideloading, Staging C Compiler) (artex_ad_ntlm_relay_chisel_sideload_pivots.yml | id=3f7a9d12-8b54-4e61-a29f-6c4d81e5b204 | level=high) ===
imProcessCreate
| where (TargetProcessCommandLine contains "chisel client" or TargetProcessCommandLine contains "chisel.exe client" or TargetProcessCommandLine contains "R:socks" or TargetProcessCommandLine contains "proxychains -f" or TargetProcessCommandLine contains "proxychains4 -f" or TargetProcessCommandLine contains "ligolo-agent") or (TargetProcessCommandLine contains "ntlmrelayx" or TargetProcessCommandLine contains "smbserver.py" or TargetProcessCommandLine contains "petitpotam" or TargetProcessCommandLine contains "coercer" or TargetProcessCommandLine contains "certipy" or TargetProcessCommandLine contains "ldapdomaindump") or (((TargetProcessName endswith "\\edge.exe" or TargetProcessName endswith "\\msedge.exe") and TargetProcessCommandLine contains "config.bin") and (not((TargetProcessName contains "\\Program Files\\" or TargetProcessName contains "\\Program Files (x86)\\" or TargetProcessName contains "\\Windows\\System32\\"))))

// === VAPOR PANDA BLOODALCHEMY Sideloading, C2 URI, or ARTEX Config/Proxy Artifacts (artex_bloodalchemy_sideload_and_c2.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a016 | level=critical) ===
imProcessCreate
| where (TargetProcessCommandLine contains "graphics-hook-filter64.dll" or TargetProcessCommandLine contains "graphics-hook_config.bin" or TargetProcessCommandLine contains "artex_config.json" or TargetProcessCommandLine contains "artex.yaml" or TargetProcessCommandLine contains "\\ProgramData\\artx5v\\" or TargetProcessCommandLine contains "/Inform/logger/" or TargetProcessCommandLine contains "xcai.com" or TargetProcessCommandLine contains "xcai.pro") or (TargetProcessCommandLine contains "tomicdd/artex" or TargetProcessCommandLine contains "congdonglinux/artex")

// === Rapid Automated EDR Sensor Discovery Commands (artex_edr_evasion_probe.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a003 | level=medium) ===
imProcessCreate
| where (TargetProcessCommandLine contains "sc query" or TargetProcessCommandLine contains "Get-Service" or TargetProcessCommandLine contains "tasklist" or TargetProcessCommandLine contains "wmic process") and (TargetProcessCommandLine contains "CSFalcon" or TargetProcessCommandLine contains "CrowdStrike" or TargetProcessCommandLine contains "SentinelAgent" or TargetProcessCommandLine contains "CbDefense" or TargetProcessCommandLine contains "WinDefend" or TargetProcessCommandLine contains "Sysmon")

// === Web or Appliance Process Spawning Shell or Compressed Cloud/AD Recon Commands (artex_endpoint_compressed_recon_burst.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a014 | level=high) ===
imProcessCreate
| where (((ParentProcessName contains "w3wp.exe" or ParentProcessName contains "nginx" or ParentProcessName contains "httpd" or ParentProcessName contains "php-fpm" or ParentProcessName contains "restjavad") or (ActingProcessName contains "w3wp.exe" or ActingProcessName contains "nginx" or ActingProcessName contains "httpd" or ActingProcessName contains "php-fpm" or ActingProcessName contains "restjavad")) and (TargetProcessName contains "cmd.exe" or TargetProcessName contains "powershell.exe" or TargetProcessName contains "pwsh" or TargetProcessName contains "/bin/sh" or TargetProcessName contains "/bin/bash")) or (TargetProcessCommandLine contains "nltest /domain_trusts" or TargetProcessCommandLine contains "aws sts get-caller-identity" or TargetProcessCommandLine contains "az account show")

// === Potential ARTEX or ScopeWeaver Framework Artifact or Default Listener (artex_network_listener.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a001 | level=high) ===
imNetworkSession
| where (DstPortNumber in (8787, 8788, 8790, 8890)) or ((SrcProcessName contains "ScopeWeaver" or SrcProcessName contains "AntiFox" or SrcProcessName contains "Pojun" or SrcProcessName contains "FORANG" or SrcProcessName contains "sco-fix2" or SrcProcessName contains "artx5v" or SrcProcessName contains "artex-server" or SrcProcessName contains "artex-worker" or SrcProcessName contains "norma-agent") or (DstProcessName contains "ScopeWeaver" or DstProcessName contains "AntiFox" or DstProcessName contains "Pojun" or DstProcessName contains "FORANG" or DstProcessName contains "sco-fix2" or DstProcessName contains "artx5v" or DstProcessName contains "artex-server" or DstProcessName contains "artex-worker" or DstProcessName contains "norma-agent"))

// === ARTEX Post-Exploitation AD Credential Dumping (Kerberoast/DCSync) or Follow-On C2 (vshell/AdaptixC2/WISP) (artex_post_exploit_ad_and_followon_c2.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a020 | level=critical) ===
imProcessCreate
| where (TargetProcessCommandLine contains "lsadump::" or TargetProcessCommandLine contains "sekurlsa::" or TargetProcessCommandLine contains "kerberoast" or TargetProcessCommandLine contains "GetUserSPNs" or TargetProcessCommandLine contains "DS-Replication-Get-Changes") or (TargetProcessCommandLine contains "vshell" or TargetProcessCommandLine contains "AdaptixC2" or TargetProcessCommandLine contains "sqlserver-sqlite.com")
