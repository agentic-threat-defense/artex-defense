// === Autonomous Agentic AD Pivot Toolkit (Chisel/Proxychains, NTLM Relay, Relocated DLL Sideloading, Staging C Compiler) (artex_ad_ntlm_relay_chisel_sideload_pivots.yml | id=3f7a9d12-8b54-4e61-a29f-6c4d81e5b204 | level=high) ===
from * metadata _id, _index, _version | where process.command_line like "*chisel client*" or process.command_line like "*chisel.exe client*" or process.command_line like "*R:socks*" or process.command_line like "*proxychains -f*" or process.command_line like "*proxychains4 -f*" or process.command_line like "*ligolo-agent*" or process.command_line like "*ntlmrelayx*" or process.command_line like "*smbserver.py*" or process.command_line like "*petitpotam*" or process.command_line like "*coercer*" or process.command_line like "*certipy*" or process.command_line like "*ldapdomaindump*" or (ends_with(process.executable.caseless, "\\edge.exe") or ends_with(process.executable.caseless, "\\msedge.exe")) and process.command_line like "*config.bin*" and not (process.executable.caseless like "*\\program files\\*" or process.executable.caseless like "*\\program files (x86)\\*" or process.executable.caseless like "*\\windows\\system32\\*")

// === ARTEX Cloud Reconnaissance — AWS CloudWatch Secret Search or DryRun Permission Sweep (artex_aws_cloudwatch_and_dryrun_sweep.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a019 | level=high) ===
from * metadata _id, _index, _version | where event.action=="FilterLogEvents" and (aws.cloudtrail.request_parameters.filterPattern like "*password*" or aws.cloudtrail.request_parameters.filterPattern like "*AKIA*" or aws.cloudtrail.request_parameters.filterPattern like "*secret*" or aws.cloudtrail.request_parameters.filterPattern like "*token*") or error.code like "*DryRunOperation*"

// === AWS CloudTrail Agentic EC2 userData Harvesting, SSM Decryption/SendCommand, or External EC2 Role Replay (artex_aws_cyberstrikeai_userdata_ssm_and_ec2_role.yml | id=7c2e41b8-5a93-4d7c-9e12-4b8f71a6c309 | level=high) ===
from * metadata _id, _index, _version | where event.action=="DescribeInstanceAttribute" and aws.cloudtrail.request_parameters.attribute=="userData" or (event.action in ("GetParametersByPath", "GetParameter", "GetParameters")) and aws.cloudtrail.request_parameters.withDecryption==true or event.action=="SendCommand" or aws.cloudtrail.user_identity.arn like "*assumed-role/*" and (event.action in ("DescribeInstanceAttribute", "GetSecretValue", "GetParametersByPath", "SendCommand"))

// === VAPOR PANDA BLOODALCHEMY Sideloading, C2 URI, or ARTEX Config/Proxy Artifacts (artex_bloodalchemy_sideload_and_c2.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a016 | level=critical) ===
from * metadata _id, _index, _version | where process.command_line like "*graphics-hook-filter64.dll*" or process.command_line like "*graphics-hook_config.bin*" or process.command_line like "*artex_config.json*" or process.command_line like "*artex.yaml*" or process.command_line like "*\\ProgramData\\artx5v\\*" or process.command_line like "*/Inform/logger/*" or process.command_line like "*xcai.com*" or process.command_line like "*xcai.pro*" or process.command_line like "*tomicdd/artex*" or process.command_line like "*congdonglinux/artex*"

// === Potential ARTEX Rapid VPN Authentication Spray or WebVPN Probing on Cisco ASA / FTD (artex_cisco_asa_ftd_rapid_vpn_spray.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a010 | level=high) ===
from * metadata _id, _index, _version | where event.code in ("113015", "716039") or url.original like "*/+CSCOE+/*" or url.original like "*/+webvpn+/*"

// === Potential ARTEX Automated Probing or Harness Activity Against Citrix NetScaler Gateway (artex_citrix_netscaler_agentic_probe.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a011 | level=high) ===
from * metadata _id, _index, _version | where (url.original like "*/vpn/*" or url.original like "*/nf/auth/*" or url.original like "*/logon/LogonPoint/*" or url.original like "*/p/u/*" or url.original like "*/nitro/v1*") and (user_agent.original like "*HeadlessChrome*" or user_agent.original like "*Nuclei*" or user_agent.original like "*norma/*" or user_agent.original like "*norma-agent*" or user_agent.original like "*artex/*" or user_agent.original like "*artex-*" or user_agent.original like "*ScopeWeaver*")

// === ARTEX Control-Plane Routes, Recording Proxy (8788 / mitmproxy CA), or Task Cmd-Output Spill (artex_console_and_operator_host_forensics.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a018 | level=high) ===
from * metadata _id, _index, _version | where url.original like "*/api/exploration/*" or url.original like "*/api/intercept/*" or url.original like "*/api/sync/scopesentry*" or url.original like "*/api/llm/profiles*" or url.original like "*/api/llm/records*" or url.original like "*/function/tasks*" or url.original like "*/function/findings*" or CommandLine like "*/cmd-output/*" or CommandLine like "*mitmproxy-ca-cert.pem*" or CommandLine like "*traffic/_index/index.sqlite*" or CommandLine like "*artex_token=*" or user_agent.original like "*artex-selfupdate*"

// === Rapid Automated EDR Sensor Discovery Commands (artex_edr_evasion_probe.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a003 | level=medium) ===
from * metadata _id, _index, _version | where (process.command_line like "*sc query*" or process.command_line like "*Get-Service*" or process.command_line like "*tasklist*" or process.command_line like "*wmic process*") and (process.command_line like "*CSFalcon*" or process.command_line like "*CrowdStrike*" or process.command_line like "*SentinelAgent*" or process.command_line like "*CbDefense*" or process.command_line like "*WinDefend*" or process.command_line like "*Sysmon*")

// === Web or Appliance Process Spawning Shell or Compressed Cloud/AD Recon Commands (artex_endpoint_compressed_recon_burst.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a014 | level=high) ===
from * metadata _id, _index, _version | where (process.parent.executable.caseless like "*w3wp.exe*" or process.parent.executable.caseless like "*nginx*" or process.parent.executable.caseless like "*httpd*" or process.parent.executable.caseless like "*php-fpm*" or process.parent.executable.caseless like "*restjavad*") and (process.executable.caseless like "*cmd.exe*" or process.executable.caseless like "*powershell.exe*" or process.executable.caseless like "*pwsh*" or process.executable.caseless like "*/bin/sh*" or process.executable.caseless like "*/bin/bash*") or process.command_line like "*nltest /domain_trusts*" or process.command_line like "*aws sts get-caller-identity*" or process.command_line like "*az account show*"

// === Microsoft Entra ID Service Principal Secret Guessing (7000215) or MFA Denial / Security Info Tampering (artex_entra_sp_secret_abuse_and_mfa_tampering.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a022 | level=high) ===
from * metadata _id, _index, _version | where azure.signinlogs.result_type in ("7000215", "7000222", "500121") or event.action like "*Register security info*" or event.action like "*Add service principal credentials*" or event.action like "*AddServicePrincipalCredentials*" or event.action like "*Consent to application*" or event.action like "*ConsentToApplication*"

// === Duo Security, PingFederate, and Google Workspace 2FA Fatigue & Factor Tampering (artex_idp_duo_ping_gws_2fa_abuse.yml | id=9b4e1a27-3c8f-4f92-b7c1-8d2e60f4a139 | level=high) ===
from * metadata _id, _index, _version | where Action like "*duo_fraud_reported*" or Action like "*fraud_reported*" or Action like "*user_marked_fraud*" or Action like "*duo_admin:bypass_create*" or Action like "*duo_admin:phone_create*" or Action like "*duo_admin:2fa_device_enroll*" or Action like "*pingid_device_paired*" or Action like "*mfa_device_enrolled*" or Action like "*mfa_rejected*" or Action like "*2sv_disable*" or Action like "*2sv_enroll*" or Action like "*recovery_phone_edit*" or Action like "*recovery_email_edit*" or Action like "*second_factor_failure*"

// === Anomalous Server or Endpoint Egress to External LLM APIs (artex_llm_api_egress.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a002 | level=medium) ===
from * metadata _id, _index, _version | where (ends_with(dns.question.name, "api.anthropic.com") or ends_with(dns.question.name, "api.openai.com") or ends_with(dns.question.name, "api.deepseek.com") or ends_with(dns.question.name, "open.bigmodel.cn") or ends_with(dns.question.name, "api.x.ai") or ends_with(dns.question.name, "api.moonshot.cn") or ends_with(dns.question.name, "api.moonshot.ai") or ends_with(dns.question.name, "dashscope.aliyuncs.com") or ends_with(dns.question.name, "openrouter.ai") or ends_with(dns.question.name, "api.siliconflow.cn") or ends_with(dns.question.name, "xcai.com") or ends_with(dns.question.name, "xcai.pro") or ends_with(dns.question.name, "artex.lol") or ends_with(dns.question.name, "lanmao666.com") or ends_with(dns.question.name, "lanmao666.xyz") or ends_with(dns.question.name, "nginxmysql.com") or ends_with(dns.question.name, "vietnam852.com") or ends_with(dns.question.name, "zhzy999.net")) and not (starts_with(winlog.computer_name, "DEV-AI-GW-") or starts_with(winlog.computer_name, "WKSTN-") or starts_with(winlog.computer_name, "LAPTOP-"))

// === Potential ARTEX or ScopeWeaver Framework Artifact or Default Listener (artex_network_listener.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a001 | level=high) ===
from * metadata _id, _index, _version | where destination.port in (8787, 8788, 8790, 8890) or process.executable.caseless like "*scopeweaver*" or process.executable.caseless like "*antifox*" or process.executable.caseless like "*pojun*" or process.executable.caseless like "*forang*" or process.executable.caseless like "*sco-fix2*" or process.executable.caseless like "*artx5v*" or process.executable.caseless like "*artex-server*" or process.executable.caseless like "*artex-worker*" or process.executable.caseless like "*norma-agent*"

