from * metadata _id, _index, _version | where event.action in ("user.mfa.okta_verify.deny_push", "user.mfa.factor.activate", "user.mfa.factor.deactivate", "user.mfa.factor.reset_all", "user.risk.detect", "workflows.user.invoke") or okta.outcome.reason=="VERIFICATION_ERROR" or okta.debug_context.debug_data.request_uri like "*/api/v1/authn*" and okta.outcome.result=="FAILURE" or okta.debug_context.debug_data.request_uri like "*/api/flo/*" or okta.debug_context.debug_data.request_uri like "*clientToken=*"

