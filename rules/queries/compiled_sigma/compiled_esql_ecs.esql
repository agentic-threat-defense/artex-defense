from * metadata _id, _index, _version | where `c-uri` like "*/api/exploration/*" or `c-uri` like "*/api/intercept/*" or `c-uri` like "*/api/sync/scopesentry*" or `c-uri` like "*/api/llm/profiles*" or `c-uri` like "*/api/llm/records*" or `c-uri` like "*/function/tasks*" or `c-uri` like "*/function/findings*" or CommandLine like "*/cmd-output/*" or CommandLine like "*mitmproxy-ca-cert.pem*" or CommandLine like "*traffic/_index/index.sqlite*" or CommandLine like "*artex_token=*" or `cs-user-agent` like "*artex-selfupdate*"

