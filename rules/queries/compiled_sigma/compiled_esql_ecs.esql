from * metadata _id, _index, _version | where url.original like "*zz_no_such_user*" or url.original like "*zzq.nonexistent*" or url.original like "*precheck.not-a-user*" or url.original like "*zzzrandom*" or url.original like "*zz-no-such-key*" or url.original like "*zz-notexist-*" or url.original like "*nonexistent-i*" or url.original like "*ARTEX_WRITE_PROBE*" or url.original like "*ARTEX_PERSIST_OK*" or url.original like "*artex_control_marker*" or url.original like "*artex=*" or url.original like "*eyJhbGciOiJub25l*" or user_agent.original like "*security-testing; authorized*" or user_agent.original like "*LLMLeak-RedTeam/*" or user_agent.original like "*authorised-scan*" or user_agent.original like "*authorized-security-research/*" or user_agent.original like "*vulnerability-disclosure-policy-review*" or user_agent.original like "*authorized-exposure-audit/*" or user_agent.original like "*recon-audit*" or user_agent.original like "*Fuzz Faster U Fool*" or user_agent.original like "*ArtExVerify/1.0*" or user_agent.original like "*Mozilla/5.0 (ARTEX)*" or Action like "*illegal_redirect_uri_enhanced*"

// === Web Portal Sensitive Endpoint Access Following Automated Probing (Agentic Error-Correction Pivot) (artex_web_error_correction_burst.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a013 | level=critical) ===
