from * metadata _id, _index, _version | where (url.original like "*/global-protect/*" or url.original like "*/ssl-vpn/*" or url.original like "*/my.policy*" or url.original like "*/tmui/*" or url.original like "*/mgmt/tm/*") and (user_agent.original like "*Nuclei*" or user_agent.original like "*HeadlessChrome*" or user_agent.original like "*norma/*" or user_agent.original like "*norma-agent*" or user_agent.original like "*python-httpx*" or user_agent.original like "*Go-http-client*")

