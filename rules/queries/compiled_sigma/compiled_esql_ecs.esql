from * metadata _id, _index, _version | where url.domain like "*webhook.site*" or url.domain like "*oast.live*" or url.domain like "*oast.fun*" or url.domain like "*interact.sh*" or user_agent.original like "*norma/*" or user_agent.original like "*norma-agent*" or user_agent.original like "*artex-enrich/*" or user_agent.original like "*artex-readonly/*" or user_agent.original like "*ARTEX-worker/*" or user_agent.original like "*ArtexProbe*" or user_agent.original like "*artex-probe*"
