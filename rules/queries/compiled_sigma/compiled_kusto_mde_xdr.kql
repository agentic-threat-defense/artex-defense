DeviceProcessEvents
| where (ProcessCommandLine contains "sc query" or ProcessCommandLine contains "Get-Service" or ProcessCommandLine contains "tasklist" or ProcessCommandLine contains "wmic process") and (ProcessCommandLine contains "CSFalcon" or ProcessCommandLine contains "CrowdStrike" or ProcessCommandLine contains "SentinelAgent" or ProcessCommandLine contains "CbDefense" or ProcessCommandLine contains "WinDefend" or ProcessCommandLine contains "Sysmon")

// === Windows Web/Service Parent Spawning Shell or Cloud/AD Recon Commands (artex_endpoint_compressed_recon_burst.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a014 | level=medium) ===
DeviceProcessEvents
| where ((InitiatingProcessFolderPath endswith "\\w3wp.exe" or InitiatingProcessFolderPath endswith "\\nginx.exe" or InitiatingProcessFolderPath endswith "\\httpd.exe" or InitiatingProcessFolderPath endswith "\\tomcat.exe" or InitiatingProcessFolderPath endswith "\\sqlservr.exe") and (FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe")) or (ProcessCommandLine contains "nltest" and ProcessCommandLine contains "/domain_trusts") or (ProcessCommandLine contains "aws" and ProcessCommandLine contains "sts" and ProcessCommandLine contains "get-caller-identity") or (ProcessCommandLine contains "az" and ProcessCommandLine contains "account" and ProcessCommandLine contains "show")

// === Autonomous Agentic Linux Staging C Compilation, Proxychains/AD Pivot, or ARTEX Host Artifacts (artex_linux_staging_compiler_and_proxychains_pivot.yml | id=9f4e2a17-6b3c-4d8e-9a51-2c7b80e4d312 | level=high) ===
DeviceProcessEvents
| where ((FolderPath endswith "gcc" or FolderPath endswith "g++" or FolderPath endswith "clang" or FolderPath endswith "clang++" or FolderPath endswith "/cc") and (ProcessCommandLine contains "/tmp/" or ProcessCommandLine contains "/dev/shm/" or ProcessCommandLine contains "/var/tmp/") and (not((InitiatingProcessFolderPath endswith "/dpkg" or InitiatingProcessFolderPath endswith "/apt" or InitiatingProcessFolderPath endswith "/yum" or InitiatingProcessFolderPath endswith "/dnf" or InitiatingProcessFolderPath endswith "/rpm" or InitiatingProcessFolderPath endswith "/pip" or InitiatingProcessFolderPath endswith "/pip3" or InitiatingProcessFolderPath endswith "/cargo" or InitiatingProcessFolderPath endswith "/go" or InitiatingProcessFolderPath endswith "/dkms" or InitiatingProcessFolderPath endswith "/cmake")))) or (ProcessCommandLine contains "proxychains" or ProcessCommandLine contains "proxychains4") or (ProcessCommandLine contains "chisel" and ProcessCommandLine contains "client") or (ProcessCommandLine contains "ligolo-agent" or ProcessCommandLine contains "ntlmrelayx" or ProcessCommandLine contains "smbserver.py" or ProcessCommandLine contains "petitpotam" or ProcessCommandLine contains "coercer" or ProcessCommandLine contains "certipy" or ProcessCommandLine contains "ldapdomaindump" or ProcessCommandLine contains "evil-winrm" or ProcessCommandLine contains "netexec") or (ProcessCommandLine contains "mitmproxy-ca-cert.pem" or ProcessCommandLine contains "traffic/_index/index.sqlite" or ProcessCommandLine contains "/cmd-output/" or ProcessCommandLine contains "tomicdd/artex" or ProcessCommandLine contains "congdonglinux/artex") or (FolderPath endswith "/ssh" and (ProcessCommandLine contains " -R " or ProcessCommandLine contains " -NR " or ProcessCommandLine contains " -fNR " or ProcessCommandLine contains " -NTR " or ProcessCommandLine contains "RemoteForward") and ProcessCommandLine contains ":")

// === Potential ARTEX or ScopeWeaver Framework Artifact or Default Listener (artex_network_listener.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a001 | level=high) ===
DeviceNetworkEvents
| where ((RemotePort in (8787, 8788, 8790, 8890)) and (not((RemotePort == 8890 and (InitiatingProcessFolderPath endswith "\\ZSATunnel.exe" or InitiatingProcessFolderPath endswith "\\ZSAService.exe" or InitiatingProcessFolderPath endswith "\\ZSAUpm.exe" or InitiatingProcessFolderPath endswith "\\ZSATray.exe"))))) or (InitiatingProcessFolderPath contains "ScopeWeaver" or InitiatingProcessFolderPath contains "AntiFox" or InitiatingProcessFolderPath contains "Pojun" or InitiatingProcessFolderPath contains "FORANG" or InitiatingProcessFolderPath contains "sco-fix2" or InitiatingProcessFolderPath contains "artx5v" or InitiatingProcessFolderPath contains "artex-server" or InitiatingProcessFolderPath contains "artex-worker" or InitiatingProcessFolderPath contains "norma-agent")

