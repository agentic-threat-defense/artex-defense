// === Autonomous Agentic AD Pivot Toolkit (Chisel/Proxychains, NTLM Relay, Relocated DLL Sideloading, Staging C Compiler) (artex_ad_ntlm_relay_chisel_sideload_pivots.yml | id=3f7a9d12-8b54-4e61-a29f-6c4d81e5b204 | level=high) ===
DeviceProcessEvents
| where (ProcessCommandLine contains "chisel client" or ProcessCommandLine contains "chisel.exe client" or ProcessCommandLine contains "R:socks" or ProcessCommandLine contains "proxychains -f" or ProcessCommandLine contains "proxychains4 -f" or ProcessCommandLine contains "ligolo-agent") or (ProcessCommandLine contains "ntlmrelayx" or ProcessCommandLine contains "smbserver.py" or ProcessCommandLine contains "petitpotam" or ProcessCommandLine contains "coercer" or ProcessCommandLine contains "certipy" or ProcessCommandLine contains "ldapdomaindump") or (((FolderPath endswith "\\edge.exe" or FolderPath endswith "\\msedge.exe") and ProcessCommandLine contains "config.bin") and (not((FolderPath contains "\\Program Files\\" or FolderPath contains "\\Program Files (x86)\\" or FolderPath contains "\\Windows\\System32\\"))))

// === VAPOR PANDA BLOODALCHEMY Sideloading, C2 URI, or ARTEX Config/Proxy Artifacts (artex_bloodalchemy_sideload_and_c2.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a016 | level=critical) ===
DeviceProcessEvents
| where (ProcessCommandLine contains "graphics-hook-filter64.dll" or ProcessCommandLine contains "graphics-hook_config.bin" or ProcessCommandLine contains "artex_config.json" or ProcessCommandLine contains "artex.yaml" or ProcessCommandLine contains "\\ProgramData\\artx5v\\" or ProcessCommandLine contains "/Inform/logger/" or ProcessCommandLine contains "xcai.com" or ProcessCommandLine contains "xcai.pro") or (ProcessCommandLine contains "tomicdd/artex" or ProcessCommandLine contains "congdonglinux/artex")

// === Rapid Automated EDR Sensor Discovery Commands (artex_edr_evasion_probe.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a003 | level=medium) ===
DeviceProcessEvents
| where (ProcessCommandLine contains "sc query" or ProcessCommandLine contains "Get-Service" or ProcessCommandLine contains "tasklist" or ProcessCommandLine contains "wmic process") and (ProcessCommandLine contains "CSFalcon" or ProcessCommandLine contains "CrowdStrike" or ProcessCommandLine contains "SentinelAgent" or ProcessCommandLine contains "CbDefense" or ProcessCommandLine contains "WinDefend" or ProcessCommandLine contains "Sysmon")

// === Web or Appliance Process Spawning Shell or Compressed Cloud/AD Recon Commands (artex_endpoint_compressed_recon_burst.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a014 | level=high) ===
DeviceProcessEvents
| where ((InitiatingProcessFolderPath contains "w3wp.exe" or InitiatingProcessFolderPath contains "nginx" or InitiatingProcessFolderPath contains "httpd" or InitiatingProcessFolderPath contains "php-fpm" or InitiatingProcessFolderPath contains "restjavad") and (FolderPath contains "cmd.exe" or FolderPath contains "powershell.exe" or FolderPath contains "pwsh" or FolderPath contains "/bin/sh" or FolderPath contains "/bin/bash")) or (ProcessCommandLine contains "nltest /domain_trusts" or ProcessCommandLine contains "aws sts get-caller-identity" or ProcessCommandLine contains "az account show")

// === Potential ARTEX or ScopeWeaver Framework Artifact or Default Listener (artex_network_listener.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a001 | level=high) ===
DeviceNetworkEvents
| where (RemotePort in (8787, 8788, 8790, 8890)) or (InitiatingProcessFolderPath contains "ScopeWeaver" or InitiatingProcessFolderPath contains "AntiFox" or InitiatingProcessFolderPath contains "Pojun" or InitiatingProcessFolderPath contains "FORANG" or InitiatingProcessFolderPath contains "sco-fix2" or InitiatingProcessFolderPath contains "artx5v" or InitiatingProcessFolderPath contains "artex-server" or InitiatingProcessFolderPath contains "artex-worker" or InitiatingProcessFolderPath contains "norma-agent")

// === ARTEX Post-Exploitation AD Credential Dumping (Kerberoast/DCSync) or Follow-On C2 (vshell/AdaptixC2/WISP) (artex_post_exploit_ad_and_followon_c2.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a020 | level=critical) ===
DeviceProcessEvents
| where (ProcessCommandLine contains "lsadump::" or ProcessCommandLine contains "sekurlsa::" or ProcessCommandLine contains "kerberoast" or ProcessCommandLine contains "GetUserSPNs" or ProcessCommandLine contains "DS-Replication-Get-Changes") or (ProcessCommandLine contains "vshell" or ProcessCommandLine contains "AdaptixC2" or ProcessCommandLine contains "sqlserver-sqlite.com")
