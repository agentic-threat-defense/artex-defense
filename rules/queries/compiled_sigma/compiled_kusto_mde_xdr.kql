DeviceProcessEvents
| where (ProcessCommandLine contains "lsadump::" or ProcessCommandLine contains "sekurlsa::" or ProcessCommandLine contains "kerberoast" or ProcessCommandLine contains "GetUserSPNs" or ProcessCommandLine contains "DS-Replication-Get-Changes") or (((ProcessCommandLine contains "vshell.exe" or ProcessCommandLine contains "vshell " or ProcessCommandLine contains "AdaptixC2" or ProcessCommandLine contains "wisp-c2" or ProcessCommandLine contains "wisp_c2" or ProcessCommandLine contains "sqlserver-sqlite.com") or (FolderPath endswith "\\vshell.exe" or FolderPath endswith "\\wisp.exe")) and (not((ProcessCommandLine contains "VsDevShell" or ProcessCommandLine contains "VisualStudio.DevShell"))))
