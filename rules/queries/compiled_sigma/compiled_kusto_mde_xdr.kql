// === Autonomous Agentic AD Pivot & Tunneling Toolkit (Windows) (artex_ad_ntlm_relay_chisel_sideload_pivots.yml | id=3f7a9d12-8b54-4e61-a29f-6c4d81e5b204 | level=high) ===
DeviceProcessEvents
| where (ProcessCommandLine contains "chisel" and ProcessCommandLine contains "client") or (ProcessCommandLine contains "R:socks" or ProcessCommandLine contains "ligolo-agent" or ProcessCommandLine contains "vpncmd") or (ProcessCommandLine contains "ntlmrelayx" or ProcessCommandLine contains "smbserver.py" or ProcessCommandLine contains "petitpotam" or ProcessCommandLine contains "coercer" or ProcessCommandLine contains "certipy" or ProcessCommandLine contains "ldapdomaindump" or ProcessCommandLine contains "evil-winrm" or ProcessCommandLine contains "netexec") or (FolderPath endswith "\\cookie_exporter.exe" or ProcessCommandLine contains "cookie_exporter.exe") or ((((FolderPath endswith "\\edge.exe" or FolderPath endswith "\\msedge.exe") and ProcessCommandLine contains "config.bin") or FolderPath endswith "\\svchost.exe") and (not((FolderPath contains "\\Program Files\\" or FolderPath contains "\\Program Files (x86)\\" or FolderPath contains "\\Windows\\System32\\" or FolderPath contains "\\Windows\\SysWOW64\\" or FolderPath contains "\\Windows\\WinSxS\\" or FolderPath contains "\\AppData\\Local\\Microsoft\\Edge\\Application\\" or FolderPath contains "\\AppData\\Local\\Microsoft\\EdgeUpdate\\"))))

// === VAPOR PANDA BLOODALCHEMY Sideloading, C2 URI, or ARTEX Config/Proxy Artifacts (artex_bloodalchemy_sideload_and_c2.yml | id=6d3b2c4e-9a41-4c9e-8b4d-1e7f90c1a016 | level=critical) ===
DeviceProcessEvents
| where (ProcessCommandLine contains "graphics-hook-filter64.dll" or ProcessCommandLine contains "graphics-hook_config.bin" or ProcessCommandLine contains "artex_config.json" or ProcessCommandLine contains "artex.yaml" or ProcessCommandLine contains "\\ProgramData\\artx5v\\" or ProcessCommandLine contains "/Inform/logger/" or ProcessCommandLine contains "xcai.com" or ProcessCommandLine contains "xcai.pro") or FolderPath contains "\\ProgramData\\artx5v\\" or (ProcessCommandLine contains "tomicdd/artex" or ProcessCommandLine contains "congdonglinux/artex")

